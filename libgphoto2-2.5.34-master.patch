+{
+	uint16_t		ret;
+	PTPPropValue		propval;
+	PTPContainer		event;
+	int			i;
+
+	ptp_debug (params,"PTP: (Olympus Exit) leaving PC mode...");
+
+	propval.u16 = params->olympus_camera_control_mode;
